{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
		"types": ["node", "trusted-types"],
		"typeRoots": ["./node_modules/@types"],
		"paths": {
			"@vscode-source/*": ["./vendor/vscode/src/vs/*"],
			"*": ["./node_modules/*"]
		},
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"useUnknownInCatchVariables": false,
		"noImplicitOverride": true,
		"resolveJsonModule": true,
		"esModuleInterop": true
	},
	"include": [
		"src/**/*.ts", "test/**/*.ts",
		"vendor/vscode/src/typings/base-common.d.ts",
		"vendor/vscode/src/typings/css.d.ts",
		"vendor/vscode/src/typings/thenable.d.ts",
		"vendor/vscode/src/typings/vscode-globals-*.d.ts",
		"vendor/vscode/src/typings/crypto.d.ts"
	],
	"exclude": ["src/companion", "test/companion.test.ts"]
}
